{
  "name": "phosphor-console-doc-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-metadata.mjs",
    "sandbox": "vite build --config vite.sandbox.config.ts --outDir public",
    "predev": "npm run generate && npm run sandbox",
    "dev": "vite",
    "prebuild": "npm run generate && npm run sandbox",
    "build": "tsc --noEmit && vite build",
    "typecheck": "npm run generate && tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "fuse.js": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
