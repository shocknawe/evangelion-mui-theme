{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Resolve the theme + component sources (mirrors the Vite alias) so the site
       type-checks against them without a package build. They live at the repo
       root with no adjacent node_modules, so map their bare specifiers — react,
       @mui, @emotion — to this site's install. */
    "paths": {
      "@theme": ["../theme/index.ts"],
      "@components": ["../components/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "*": ["./node_modules/*"]
    },

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../theme", "../components"]
}
